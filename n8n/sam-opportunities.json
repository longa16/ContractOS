      },
      "id": "contractos-ingest",
      "name": "Ingest approved SAM source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    }
  ],
  "connections": {
    "Every six hours": {
      "main": [
        [{ "node": "Ingest approved SAM source", "type": "main", "index": 0 }]
      ]
